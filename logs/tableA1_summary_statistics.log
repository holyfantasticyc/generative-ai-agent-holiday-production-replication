. **## Human agent level
. use "$temp/vacation_full_data_no_collapse" , clear

. keep if !if_AI 
(46,488 observations deleted)

. sort crm_user_id date_create_time hour_create_time minute_create_time

. bys crm_user_id date_create_time: gen task_order = _n

