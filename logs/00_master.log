. do "$replication/code/tables/tableA4_robust_w_1h.do"

. *-------------------------------------------------------------------
. * tableA4_robust_w_1h.do  --  PNAS Nexus replication package
. *
. * Generates Table A.4 (Robustness: Case Closed within One Hour).
. *
. *-------------------------------------------------------------------
. if "${replication}" == "" {
.     global replication "<REPLICATION_ROOT>"
. }

. run "$replication/code/00_declare_path.do"

. 
. capture log close

. log using "$replication_log/tableA4_robust_w_1h.log", replace text
--------------------------------------------------------
      name:  <unnamed>
       log:  <REPLICATION_ROOT>/logs/tableA4_robust_w_1h.log
  log type:  text
 opened on:   9 May 2026, 09:07:10

. 
. **# Appendix Table: main results, robustness, only call within 1 hour
. 
. {
. 
. use  "$temp/vacation_connected_call_level"  , clear
. replace total_payment_amt_num = 0 if missing(total_payment_amt_num)
(0 real changes made)
. keep if vacation == 1 
(0 observations deleted)
. keep if gap_creat_lastcallthrough < 3600 // get rid of follow up call the next day
(9,242 observations deleted)
. 
. cap gen gender_customer_num = ( gender_customer == "Female" )
. replace province_capital = 1 if missing(province_capital)
(2,115 real changes made)
. replace gap_creat_lastcallthrough = gap_creat_lastcallthrough / 1
(0 real changes made)
. 
. local i = 0
. foreach y in if_succeed  bridge_duration_num bridge_duration_num n_policy_succeed payment_amt_num payment_amt_per if_refund scale_premium_num ins_amt_num {
  2. 
. // foreach y in if_succeed n_policy_succeed {
. 
. dis   "`y'"
  3.         local i = `i' + 1
  4. 
. preserve
  5. 
. if "`y'" == "if_succeed"{
  6.         local ytitle = "%"
  7.         replace `y' = `y' * 100
  8.         
. }
  9. if "`y'" == "payment_amt_num"{
 10.         
. //      global ytitle = "Payment Amount (CNY)"
.         local ytitle = "Chinese Yuan (CNY)"
 11. 
. }
 12. if "`y'" == "bridge_duration_num" & `i' == 2{
 13.         global ytitle = " Seconds "
 14.         
. }
 15. if "`y'" == "bridge_duration_num" & `i' == 3{
 16.         keep if if_succeed
 17.         global ytitle = " Seconds "
 18.         
. }
 19. if "`y'" == "payment_amt_per"{
 20.         
.         keep if if_succeed 
 21.         cap drop payment_amt_per
 22.         gen payment_amt_per = total_payment_amt_num / bridge_duration_num
 23. 
.         global ytitle = "Chinese Yuan (CNY)"
 24.         
. }
 25. if "`y'" == "if_refund"{
 26.         
.         local ytitle = "%"
 27.         replace `y' = `y' * 100
 28.         
. }
 29. 
. 
. if "`y'" == "n_policy_succeed"{
 30.         keep if if_succeed
 31. 
.         global ytitle = "Count"
 32.         
. }
 33. if "`y'" == "scale_premium_num"{
 34.         
.         global ytitle = "Scale Premium (CNY)"
 35.         
. }
 36. 
. if "`y'" == "ins_amt_num"{
 37.         
.         replace `y' = `y' / 10000
 38. 
.         global ytitle = "Insurance Amount (10000 CNY)"
 39.         
. }
 40. 
.         reghdfe `y' if_AI province_capital gender_customer_num  ///        , absorb(date_create_time hour_create_time)  cl(crm_user_id)
 41.         qui: sum  `y'
 42.         estadd local mean_y = string(r(mean), "%9.2f") , replace
 43.         estadd local date_fe "Yes" , replace
 44.         estadd local hour_create_time "Yes" , replace
 45.         estadd local r2_a =  string(e(r2_a), "%9.3f") , replace
 46.         estadd local N =  string(e(N), "%9.0f") , replace
 47. 
.         eststo table_main_c`i'
 48. 
.         
. restore 
 49. }       
