. do "$replication/code/tables/tableA3_robust_notcontrols.do"

. *-------------------------------------------------------------------
. * tableA3_robust_notcontrols.do  --  PNAS Nexus replication package
. *
. * Generates Table A.3 (Robustness: No Controls and Fixed Effects).
. *
. *-------------------------------------------------------------------
. if "${replication}" == "" {
.     global replication "<REPLICATION_ROOT>"
. }

. run "$replication/code/00_declare_path.do"

. 
. capture log close

. log using "$replication_log/tableA3_robust_notcontrols.log", replace text
-------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------
      name:  <unnamed>
       log:  <REPLICATION_ROOT>/logs/tableA3_robust_notcontrols.log
  log type:  text
 opened on:   6 Jun 2026, 22:00:03

. 
. **# Appendix Table: main results, robustness, no controls and fixed effects 
. 
. {
. 
. use  "$temp/vacation_connected_call_level"  , clear
. keep if vacation == 1
(0 observations deleted)
. 
. cap gen gender_customer_num = ( gender_customer == "Female" )
. replace province_capital = 1 if missing(province_capital)
(1,352 real changes made)
. replace gap_creat_lastcallthrough = gap_creat_lastcallthrough / 1
(0 real changes made)
. 
. local i = 0
. foreach y in if_succeed  bridge_duration_num bridge_duration_num n_policy_succeed payment_amt_num payment_amt_per if_refund scale_premium_num ins_amt_num {
  2. 
. dis   "`y'"
  3.         local i = `i' + 1
  4. 
. preserve
  5. 
. if "`y'" == "if_succeed"{
  6.         local ytitle = "%"
  7.         replace `y' = `y' * 100
  8.         
. }
  9. if "`y'" == "payment_amt_num"{
 10. 
.         replace payment_amt_num = 0 if if_succeed == 0
 11.         local ytitle = "Chinese Yuan (CNY)"
 12. 
. }
 13. if "`y'" == "bridge_duration_num" & `i' == 2{
 14.         global ytitle = " Seconds "
 15.         
. }
 16. if "`y'" == "bridge_duration_num" & `i' == 3{
 17.         keep if if_succeed
 18.         global ytitle = " Seconds "
 19.         
. }
 20. if "`y'" == "payment_amt_per"{
 21.         
.         keep if if_succeed 
 22.         cap drop payment_amt_per
 23.         gen payment_amt_per = payment_amt_num / bridge_duration_num
 24. 
.         global ytitle = "Chinese Yuan (CNY)"
 25.         
. }
 26. if "`y'" == "if_refund"{
 27.         
.         local ytitle = "%"
 28.         replace `y' = `y' * 100
 29.         
. }
 30. 
. 
. if "`y'" == "n_policy_succeed"{
 31.         keep if if_succeed
 32. 
.         global ytitle = "Count"
 33.         
. }
 34. if "`y'" == "scale_premium_num"{
 35.         
.         global ytitle = "Scale Premium (CNY)"
 36.         
. }
 37. 
. if "`y'" == "ins_amt_num"{
 38.         
.         replace `y' = `y' / 10000
 39. 
.         global ytitle = "Insurance Amount (10000 CNY)"
 40.         
. }
 41. 
.         reghdfe `y' if_AI    ///        , noa  cl(crm_user_id)
 42.         qui: sum  `y'
 43.         estadd local mean_y = string(r(mean), "%9.2f") , replace
 44.         estadd local date_fe "No" , replace
 45.         estadd local hour_create_time "No" , replace
 46.         estadd local r2_a =  string(e(r2_a), "%9.3f") , replace
 47.         estadd local N =  string(e(N), "%9.0f") , replace
 48. 
.         eststo table_main_c`i'
 49. 
.         
. restore 
 50. }       
