. *-------------------------------------------------------------------
. * tableA5_by_gender.do  --  PNAS Nexus replication package
. *
. * Generates Table A.5 (Difference between AI and Human Performance by Customer Gender).
. *
. *-------------------------------------------------------------------
. if "${replication}" == "" {
.     global replication "<REPLICATION_ROOT>"
. }

. run "$replication/code/00_declare_path.do"

. 
. capture log close

. log using "$replication_log/tableA5_by_gender.log", replace text
--------------------------------------------------------
      name:  <unnamed>
       log:  <REPLICATION_ROOT>/logs/tableA5_by_gender.log
  log type:  text
 opened on:   9 May 2026, 09:07:10

. 
. **# Appendix Table: gender effects
. {
.         
. local i = 0
.         
. use  "$temp/vacation_connected_call_level"  , clear
. replace province_capital = 1 if missing(province_capital)
(2,405 real changes made)
. 
. drop if gender_customer == "Unknown" |  gender_cno == "Unknown" 
(6,173 observations deleted)
. gen gender_customer_num = (gender_customer == "Female")
. // egen gender_customer_num = group(gender_customer)
. // egen gender_cno_num = group(gender_cno)
. 
. foreach y in if_succeed  bridge_duration_num bridge_duration_num n_policy_succeed payment_amt_num payment_amt_per if_refund scale_premium_num ins_amt_num {
  2. 
. // local group_variable gender_combine
. 
. keep if vacation == 1 
  3. 
. dis   "`y'"
  4.         local i = `i' + 1
  5. 
. preserve
  6. 
. if "`y'" == "if_succeed"{
  7.         local ytitle = "%"
  8.         replace `y' = `y' * 100
  9.         
. }
 10. if "`y'" == "payment_amt_num"{
 11.         
. //      global ytitle = "Payment Amount (CNY)"
.         local ytitle = "Chinese Yuan (CNY)"
 12. 
. }
 13. if "`y'" == "bridge_duration_num" & `i' == 2{
 14.         global ytitle = " Seconds "
 15.         
. }
 16. if "`y'" == "bridge_duration_num" & `i' == 3{
 17.         keep if if_succeed
 18.         global ytitle = " Seconds "
 19.         
. }
 20. if "`y'" == "payment_amt_per"{
 21.         
.         keep if if_succeed 
 22.         cap drop payment_amt_per
 23.         gen payment_amt_per = total_payment_amt_num / bridge_duration_num
 24. 
.         global ytitle = "Chinese Yuan (CNY)"
 25.         
. }
 26. if "`y'" == "if_refund"{
 27.         
.         local ytitle = "%"
 28.         replace `y' = `y' * 100
 29.         
. }
 30. 
. 
. if "`y'" == "n_policy_succeed"{
 31.         keep if if_succeed
 32. 
.         global ytitle = "Count"
 33.         
. }
 34. if "`y'" == "scale_premium_num"{
 35.         
.         global ytitle = "Scale Premium (CNY)"
 36.         
. }
 37. 
. if "`y'" == "ins_amt_num"{
 38.         
.         replace `y' = `y' / 10000
 39. 
.         global ytitle = "Insurance Amount (10000 CNY)"
 40.         
. }
 41. 
. gen gender_group = . 
 42. replace gender_group = 1 if if_AI
 43. replace gender_group = 2 if !if_AI  & gender_customer == "Female" 
 44. replace gender_group = 3 if !if_AI  & gender_customer == "Male" 
 45. 
. 
. // reghdfe `y' i.gender_group##i.gender_customer_num   province_capital gap_create_first_call ///
. //              , absorb(date_create_time hour_create_time ) cl(crm_user_id)
. 
. reghdfe  `y'  i.if_AI##i.gender_customer_num   province_capital  gap_create_first_call ///                , absorb(date_create_time hour_create_time ) cl(crm_user_id)
 46.         estadd local mean_y = string(r(mean), "%9.2f") , replace
 47.         estadd local date_fe "Yes" , replace
 48.         estadd local control "Yes" , replace
 49.         estadd local hour_create_time "Yes" , replace
 50.         estadd local r2_a =  string(e(r2), "%9.3f") , replace
 51.         estadd local N =  string(e(N), "%9.0f") , replace
 52. 
.         eststo table_by_gender_c`i'     
 53. restore
 54. 
. }       
