. foreach w of local weeks {
  2. 
.     if `w' == `baseweek' {
  3.         matrix `B' = `B' \ (`w', 0, 0, 0)
  4.     }
  5.     else {
  6.         quietly lincom 1.if_AI#`w'.week
  7.         matrix `B' = `B' \ (`w', r(estimate), r(lb), r(ub))
  8.     }
  9. }

