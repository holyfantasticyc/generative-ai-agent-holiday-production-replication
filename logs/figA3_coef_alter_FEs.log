 23.         replace `y' = `y' * 100
 24.         
. }
 25. 
. {
 26.         matrix A=J(5,3,.)
 27.         local k = 1
 28. 
.         /*Gap line*/
.         mat A[`k',1]=`k'
 29.         mat A[`k',2]=.
 30.         mat A[`k',3]=.
 31.         local k = `k' + 1
 32.         
.         * Parsimonious
.         {
 33. 
.         reghdfe `y' if_AI ///        , noa cl(crm_user_id)
 34. 
.         mat A[`k',1]=`k'
 35.         mat A[`k',2]=_b[if_AI]
 36.         mat A[`k',3]=_se[if_AI]
 37.         local k = `k' + 1
 38.         
.         
.         }
 39.         
.         * With controls
. 
.         {
 40. 
.         reghdfe `y' if_AI province_capital gender_customer_num ///        , noa cl(crm_user_id)
 41. 
.         mat A[`k',1]=`k'
 42.         mat A[`k',2]=_b[if_AI]
 43.         mat A[`k',3]=_se[if_AI]
 44.         local k = `k' + 1
 45.         
.         
.         }
 46. 
.         * Add date fixed effects
.         {
 47. 
.         reghdfe `y' if_AI province_capital gender_customer_num ///        , absorb(date_create_time )  cl(crm_user_id)
 48. 
.         mat A[`k',1]=`k'
