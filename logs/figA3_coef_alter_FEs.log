 50.         mat A[`k',3]=_se[if_AI]
 51.         local k = `k' + 1
 52.         
. 
.         }
 53. 
.         * Add hour fixed effects
.         {
 54. 
.         reghdfe `y' if_AI province_capital gender_customer_num ///        , absorb(date_create_time hour_create_time)  cl(crm_user_id)
 55. 
.         mat A[`k',1]=`k'
 56.         mat A[`k',2]=_b[if_AI]
 57.         mat A[`k',3]=_se[if_AI]
 58.         local k = `k' + 1
 59. 
.         }
 60. 
. }       
 61. 
.         mat list A
 62.         clear
 63.         svmat A
 64.         sum A1 
 65.         drop if A1>r(max)
 66.         drop if A2 == .
 67.         keep A1 A2 A3
 68.         
.         rename A2 coef
