 48.         estadd local hour_create_time "Yes" , replace
 49.         estadd local r2_a =  string(e(r2), "%9.3f") , replace
 50.         estadd local N =  string(e(N), "%9.0f") , replace
 51. 
.         eststo table_by_gender_c`i'     
 52. restore
 53. 
. }       
