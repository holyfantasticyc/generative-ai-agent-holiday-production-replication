. gen gender_customer_num = (gender_customer == "Female")
. 
. foreach y in if_succeed  bridge_duration_num bridge_duration_num n_policy_succeed payment_amt_num payment_amt_per if_refund scale_premium_num ins_amt_num {
  2. 
. dis   "`y'"
  3.         local i = `i' + 1
  4. 
. preserve
  5. 
. if "`y'" == "if_succeed"{
  6.         local ytitle = "%"
  7.         replace `y' = `y' * 100
  8.         
. }
  9. if "`y'" == "payment_amt_num"{
 10.         
.         local ytitle = "Chinese Yuan (CNY)"
 11. 
. }
 12. if "`y'" == "bridge_duration_num" & `i' == 2{
 13.         global ytitle = " Seconds "
 14.         
. }
 15. if "`y'" == "bridge_duration_num" & `i' == 3{
 16.         keep if if_succeed
 17.         global ytitle = " Seconds "
 18.         
. }
 19. if "`y'" == "payment_amt_per"{
 20.         
.         keep if if_succeed 
 21.         cap drop payment_amt_per
 22.         gen payment_amt_per = total_payment_amt_num / bridge_duration_num
 23. 
.         global ytitle = "Chinese Yuan (CNY)"
 24.         
. }
 25. if "`y'" == "if_refund"{
 26.         
.         local ytitle = "%"
 27.         replace `y' = `y' * 100
 28.         
. }
 29. 
. 
. if "`y'" == "n_policy_succeed"{
 30.         keep if if_succeed
 31. 
.         global ytitle = "Count"
 32.         
. }
 33. if "`y'" == "scale_premium_num"{
 34.         
.         global ytitle = "Scale Premium (CNY)"
 35.         
. }
 36. 
. if "`y'" == "ins_amt_num"{
 37.         
.         replace `y' = `y' / 10000
 38. 
.         global ytitle = "Insurance Amount (10000 CNY)"
 39.         
. }
 40. 
. gen gender_group = . 
 41. replace gender_group = 1 if if_AI
 42. replace gender_group = 2 if !if_AI  & gender_customer == "Female" 
 43. replace gender_group = 3 if !if_AI  & gender_customer == "Male"
 44. 
. 
. reghdfe  `y'  i.if_AI##i.gender_customer_num   province_capital  gap_create_first_call ///                , absorb(date_create_time hour_create_time ) cl(crm_user_id)
 45.         estadd local mean_y = string(r(mean), "%9.2f") , replace
 46.         estadd local date_fe "Yes" , replace
